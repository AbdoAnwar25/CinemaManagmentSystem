@model IEnumerable<Movie>

<div class="content">
    <div class="container-fluid">
        <div class="row mb-3 align-items-center my-3">
            <div class="col-md-6">
                <h2 class="display-6">All Movies</h2>
            </div>
            <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
                <a href="/Admin/Movie/Create" class="btn btn-success">Create</a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-none border" style="width: max-content;">
                    <div class="card-body">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Photo</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Price</th>
                                    <th scope="col">Show Time</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Cinema</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <th scope="row">@item.Id</th>
                                        <td>
                                            <img src="~/images/@item.MainImg" alt="@item.Name" class="rounded-3 border" style="width: 80px; height: 80px; object-fit: cover;" />
                                        </td>
                                        <td>@item.Name</td>
                                        <td>@item.Price.ToString("C")</td>
                                        <td>@item.DateTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@(item.Category != null ? item.Category.Name : "N/A")</td>
                                        <td>@(item.Cinema != null ? item.Cinema.Name : "N/A")</td>
                                        <td>
                                            @if (item.Status)
                                            {
                                                <span class="badge bg-success">Online</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Offline</span>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <div class="d-flex gap-2">
                                                <a href="/Admin/Movie/Update/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                                <a href="/Admin/Movie/Delete/@item.Id" class="btn btn-sm btn-danger btn-delete">Delete</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <!-- 🚀 أزرار الـ Pagination -->
                        @if (ViewBag.TotalPages > 1)
                        {
                            <nav aria-label="Page navigation" class="mt-4">
                                <ul class="pagination justify-content-center mb-0">
                                    <!-- زر الصفحة السابقة -->
                                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" href="/Admin/Movie/Index?pageNumber=@(ViewBag.CurrentPage - 1)">Previous</a>
                                    </li>

                                    <!-- أرقام الصفحات -->
                                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                                    {
                                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                            <a class="page-link" href="/Admin/Movie/Index?pageNumber=@i">@i</a>
                                        </li>
                                    }

                                    <!-- زر الصفحة التالية -->
                                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                                        <a class="page-link" href="/Admin/Movie/Index?pageNumber=@(ViewBag.CurrentPage + 1)">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

