@model IEnumerable<Category>

<div class="content">
    <div class="container-fluid">
        <div class="row mb-3 align-items-center my-3">
            <div class="col-md-6">
                <h2 class="display-6">All Categories</h2>
            </div>
            <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
                <a href="/Admin/Category/Create" class="btn btn-success">Create</a>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card shadow-none border">
                    <div class="card-body">
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach(var item in Model)
                                {
                                    <tr>
                                        <th scope="row">@item.Id</th>
                                        <td>@item.Name</td>
                                        <td>
                                            @if (item.Status)
                                            {
                                                <span class="badge bg-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">InActive</span>
                                            }
                                        </td>
                                        <td>
                                            <a href="/Admin/Category/Update/@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                            <a href="/Admin/Category/Delete/@item.Id" class="btn btn-sm btn-danger btn-delete">Delete</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
