@model CenimaManagmentSystem.ViewModels.VerifyOtpVM

@{
    ViewData["Title"] = "VerifyOtp";
}

<div class="content">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-md-6">

                <h2>VerifyOtp</h2>
                <h4>Enter your email or username</h4>
                <hr />

                <form asp-action="VerifyOtp" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input asp-for="UserId" hidden />

                    <div class="form-group mb-3">
                        <label asp-for="OTP" class="control-label mb-1"></label>
                        <input asp-for="OTP" class="form-control" />
                        <span asp-validation-for="OTP" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <input type="submit" value="Verify" class="btn btn-primary" />
                    </div>
                </form>

                <div class="mt-3">
                    <a asp-action="Login" class="btn btn-secondary">Back to Login</a>
                </div>

            </div>
        </div>
    </div>
</div>
