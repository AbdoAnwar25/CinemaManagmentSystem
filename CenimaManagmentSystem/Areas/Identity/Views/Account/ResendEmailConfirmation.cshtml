@model CenimaManagmentSystem.ViewModels.ResendEmailConfirmationVM

@{
    ViewData["Title"] = "ResendEmailConfirmation";
}

<div class="content">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-md-6">

                <h2>Resend Email Confirmation</h2>
                <h4>Enter your email or username</h4>
                <hr />

                <form asp-action="ResendEmailConfirmation" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="UserNameOrEmail" class="control-label mb-1"></label>
                        <input asp-for="UserNameOrEmail" class="form-control" />
                        <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <input type="submit" value="Resend" class="btn btn-primary" />
                    </div>
                </form>

                <div class="mt-3">
                    <a asp-action="Login" class="btn btn-secondary">Back to Login</a>
                </div>

            </div>
        </div>
    </div>
</div>
